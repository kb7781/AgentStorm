# Neon PostgreSQL connection string
# Get this from your Neon dashboard: https://console.neon.tech
# Create a new project or database named "agentstorm"
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/agentstorm?sslmode=require"

# Server port
PORT=3001

# Razorpay (Test Mode)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Groq LLM API (get free API key at https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

